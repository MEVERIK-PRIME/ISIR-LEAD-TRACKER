APP_NAME="ISIR Lead Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=isir_lead_tracker
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE=isir-leads
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ISIR_PUBLIC_WS_URL=https://isir.justice.cz:8443/isir_public_ws/IsirWsPublicService
ISIR_PUBLIC_WS_FALLBACK_URLS=https://isir.justice.cz:8443/isir_public_ws/IsirWsPublicService,https://isir.justice.cz/isir_public_ws/IsirWsPublicService
ISIR_DOCUMENT_BASE_URL=https://isir.justice.cz/isir/common/stat.do
ISIR_FINAL_REPORT_TOKEN=konec
ISIR_SYNC_PROVIDER=isir_public_ws
ISIR_SYNC_STREAM=events
ISIR_SYNC_BATCH_SIZE=250
ISIR_ORCHESTRATOR_QUEUE=default
LEAD_MIN_CLAIM_AMOUNT=300000
LEAD_MAX_CLAIM_AMOUNT=600000
ENABLE_HLIDAC_STATU=true
ENABLE_GEMINI=true
ENABLE_GROQ_FALLBACK=true

WORKER_TASK_REDIS_CONNECTION=default
WORKER_TASK_QUEUE=isir:tasks
GOOGLE_CREDS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME="Dashboard / Leady"
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

ARES_BASE_URL=https://ares.gov.cz/ekonomicke-subjekty-v-be/rest/ekonomicke-subjekty
HLIDAC_STATU_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq

VITE_APP_NAME="${APP_NAME}"
